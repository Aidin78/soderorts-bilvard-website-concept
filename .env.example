# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://soderortsbilvard.se

# Online calendar for tyre changes (the existing Amelia booking page).
# Change it if the WordPress calendar moves, e.g. to a subdomain.
TIRE_BOOKING_URL=https://soderortsbilvard.se/boka-tid-v2/

# Contact form delivery via Resend (https://resend.com). The form stays disabled,
# with a phone/e-mail notice, until both RESEND_API_KEY and CONTACT_FROM_EMAIL are set.
# These are read at build time for the static contact page – redeploy after changing them.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Söderorts Bilvård <webb@soderortsbilvard.se>"
CONTACT_TO_EMAIL=kontakt@soderortsbilvard.se
